{
  "name": "hub",
  "private": true,
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @hub/db generate",
    "db:migrate": "pnpm --filter @hub/db migrate",
    "db:seed": "pnpm --filter @hub/api seed"
  },
  "devDependencies": {
    "turbo": "catalog:"
  }
}
